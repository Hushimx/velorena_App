{
  "expo": {
    "name": "Qaads",
    "slug": "qaads",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/MAIN-LOGO.png",
    "scheme": "qaadsapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "isRTL": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qaads.app.ios",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.usernotifications.communication": true
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "package": "com.qaads.app.android",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/qaads-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2E2725"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photos to select images for designs.",
          "cameraPermission": "This app needs access to your camera to take photos for designs."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5da8bfb5-29a1-4943-8fc1-cfb82a93aded"
      },
      "apiUrl": "https://qaads.net/api"
    },
    "notification": {
      "icon": "./assets/images/MAIN-LOGO.png",
      "color": "#ffffff",
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} new interactions"
    },
    "owner": "hashim6666"
  }
}
